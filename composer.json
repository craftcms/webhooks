{
  "name": "craftcms/webhooks",
  "description": "Post webhooks when events are triggered in Craft CMS.",
  "type": "craft-plugin",
  "keywords": [
    "cms",
    "craftcms",
    "laravel",
    "webhooks"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Pixel & Tonic",
      "homepage": "https://pixelandtonic.com/"
    }
  ],
  "support": {
    "email": "support@craftcms.com",
    "issues": "https://github.com/craftcms/webhooks/issues?state=open",
    "source": "https://github.com/craftcms/webhooks",
    "docs": "https://github.com/craftcms/webhooks/blob/4.x/README.md",
    "rss": "https://github.com/craftcms/webhooks/commits/4.x.atom"
  },
  "require": {
    "php": "^8.5",
    "craftcms/cms": "^6.0.0",
    "craftcms/url-validator": "^1.2",
    "guzzlehttp/guzzle": "^7.2"
  },
  "require-dev": {
    "larastan/larastan": "^3.13",
    "laravel/pint": "^1.22",
    "orchestra/testbench": "^11.0",
    "pestphp/pest": "^5.0",
    "pestphp/pest-plugin-laravel": "^5.0",
    "phpstan/phpstan": "^2.1"
  },
  "autoload": {
    "psr-4": {
      "CraftCms\\Webhooks\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "CraftCms\\Webhooks\\Tests\\": "tests/",
      "CraftCms\\Cms\\Database\\Factories\\": "vendor/craftcms/cms/database/Factories/"
    }
  },
  "scripts": {
    "check-cs": "pint --test",
    "fix-cs": "pint",
    "phpstan": "phpstan --memory-limit=1G",
    "test": "pest"
  },
  "extra": {
    "class": "CraftCms\\Webhooks\\Plugin",
    "name": "Webhooks",
    "handle": "webhooks",
    "documentationUrl": "https://github.com/craftcms/webhooks/blob/4.x/README.md"
  },
  "config": {
    "platform": {
      "php": "8.5"
    },
    "allow-plugins": {
      "craftcms/plugin-installer": true,
      "pestphp/pest-plugin": true
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
